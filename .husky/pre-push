#!/bin/sh
# Pre-push: full local checks run before any push.
# DO NOT skip with --no-verify.
set -e

ensure_node_tooling() {
  if ! command -v pnpm >/dev/null 2>&1; then
    echo "❌ pnpm must be available before pushing"
    exit 1
  fi
}

require_main_push() {
  if ! git symbolic-ref -q HEAD >/dev/null 2>&1; then
    echo "❌ Pushes must happen from main. Detached HEAD is not allowed."
    exit 1
  fi

  CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
  if [ "$CURRENT_BRANCH" != "main" ]; then
    echo "❌ Pushes must happen from main. Current branch: $CURRENT_BRANCH"
    exit 1
  fi
}

require_main_push
ensure_node_tooling

START_TIME=$(date +%s)
echo ""
echo "🚀 Pre-push checks (replaces CI — do not skip)"
echo "================================================"

echo ""
echo "📦 [1/4] Linting & TypeScript check..."
pnpm lint
pnpm exec tsc --noEmit
echo "  ✅ Lint & TS OK"

echo ""
echo "🏗️ [2/4] Vite build..."
pnpm build
echo "  ✅ Build OK"

echo ""
echo "🧪 [3/4] Frontend tests (skipped for now)..."
# pnpm test
echo "  ✅ Tests skipped"

echo ""
echo "🔧 [4/4] Rust clippy, fmt & tests..."
cargo clippy --manifest-path=src-tauri/Cargo.toml -- -D warnings
cargo fmt --manifest-path=src-tauri/Cargo.toml -- --check
cargo test --manifest-path=src-tauri/Cargo.toml
echo "  ✅ Rust checks & tests OK"

END_TIME=$(date +%s)
ELAPSED=$((END_TIME - START_TIME))

echo ""
echo "================================================"
echo "✅ All checks passed — pushing (${ELAPSED}s)"
echo ""
